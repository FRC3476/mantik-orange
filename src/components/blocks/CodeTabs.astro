---
import { withBase } from '@/lib/withBase';
import { Code } from 'astro:components';

interface Tab {
  label: string;
  code: string;
  language?: string;
  value?: string;
}

interface Props {
  title?: string;
  description?: string;
  tabs?: Tab[];
  group?: string;
}

const shikiThemes = {
  light: 'github-light',
  dark: 'github-dark',
} as const;

const { title, description, tabs, group } = Astro.props;
const useLegacyTabs = Array.isArray(tabs) && tabs.length > 0;
const uid = `code-tabs-${Math.random().toString(36).slice(2, 9)}`;
---

{title && <h3>{title}</h3>}
{description && <p set:html={withBase(description)} />}

<div
  class="code-tabs-container"
  id={uid}
  data-code-tabs
  data-code-tabs-mode={useLegacyTabs ? 'legacy' : 'slots'}
  data-tab-group={group}
>
  <div class="code-tabs-header">
    <div class="code-tabs-wrapper">
      {useLegacyTabs &&
        tabs!.map((tab, index) => (
          <button
            type="button"
            class:list={['code-tab-button', { active: index === 0 }]}
            data-tab-index={index}
            data-tab-value={tab.value}
            data-active={index === 0 ? 'true' : 'false'}
            id={`${uid}-tab-${index}`}
          >
            {tab.label}
          </button>
        ))}
    </div>
    <button type="button" class="copy-button code-tabs-copy" data-copy-tabs aria-label="Copy code">
      <span class="copy-text">Copy</span>
    </button>
  </div>
  <div class="code-tabs-content">
    {useLegacyTabs ? (
      tabs!.map((tab, index) => (
        <div
          class:list={['code-tab-content', { active: index === 0 }]}
          id={`${uid}-panel-${index}`}
          data-tab-panel={index}
          data-tab-label={tab.label}
          data-tab-value={tab.value}
        >
          <p class="code-tab-fallback-label">{tab.label}</p>
          <div class="code-block">
            <Code
              code={tab.code}
              lang={tab.language ?? 'java'}
              themes={shikiThemes}
              wrap
            />
          </div>
        </div>
      ))
    ) : (
      <slot />
    )}
  </div>
</div>

<script>
  import { initCodeTabs } from '@/lib/frc-vision/codeTabsClient';

  initCodeTabs();
</script>
