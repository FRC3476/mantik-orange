---
import BaseLayout from '@/layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found" currentPath="/404" showSidebar={false}>
  <div class="lesson-content">
    <h1>404 — Page Not Found</h1>
    <p>The page you are looking for does not exist or has been moved.</p>
    <p>
      <a href={base}>Return to homepage</a>, or start with
      <a href={`${base}java`}>Java</a>, <a href={`${base}ftc`}>FTC</a>, or <a href={`${base}frc`}>FRC</a> training.
    </p>
  </div>
</BaseLayout>
